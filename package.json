{
  "name": "kapel",
  "version": "0.1.0",
  "description": "Kapel — a multi-model orchestration coding agent for your terminal. The strongest model plans; cheaper or specialized workers execute, under a natural-language policy compiled to a deterministic runtime.",
  "type": "module",
  "license": "MIT",
  "author": "devFallingstar",
  "homepage": "https://github.com/devFallingstar/kapel#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devFallingstar/kapel.git"
  },
  "bugs": {
    "url": "https://github.com/devFallingstar/kapel/issues"
  },
  "keywords": [
    "ai",
    "agent",
    "cli",
    "coding-agent",
    "orchestration",
    "multi-model",
    "llm",
    "anthropic",
    "openai",
    "codex"
  ],
  "bin": {
    "kapel": "./dist/kapel.js"
  },
  "files": [
    "dist/kapel.js",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "bundle": "node scripts/bundle.mjs",
    "prepare": "node scripts/prepare.mjs",
    "prepublishOnly": "npm run build && npm run bundle && npm test",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "commander": "^14",
    "drizzle-orm": "^0.45.2",
    "ink": "^6",
    "react": "^19",
    "yaml": "^2",
    "zod": "^4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "esbuild": "^0.28.2",
    "ink-testing-library": "^4.0.0",
    "typescript": "^5",
    "vitest": "^3"
  }
}
